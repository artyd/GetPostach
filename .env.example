# ---- Pigulkin backend configuration ----
# Copy to .env and fill in. Never commit the real .env.

# Database. Docker sets this to Postgres automatically (see docker-compose.yml);
# for local dev outside Docker, leave the SQLite default.
DATABASE_URL=sqlite:///./pigulkin.db

# CPHI_MILAN data source.
#  - In Docker: leave these UNSET. Compose mounts ../CPHI_MILAN/data and sets
#    CPHI_DATA_DIR=/cphi/data. Override CPHI_REPO_DIR only if the repo lives elsewhere
#    (a path relative to docker-compose.yml, e.g. ../CPHI_MILAN).
#  - Local dev on Windows: set CPHI_DATA_DIR to the absolute data path if it differs
#    from the config.py default.
# CPHI_DATA_DIR=/absolute/path/to/CPHI_MILAN/data
# CPHI_REPO_DIR=../CPHI_MILAN

# Postgres password (used by docker-compose for the db + DATABASE_URL).
POSTGRES_PASSWORD=pigulkin

# Anthropic Claude API (server-side chat). Get a key at https://console.anthropic.com
# NOTE: a Claude *subscription* is NOT the same as an API key — the backend needs an API key.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-4-6
CHAT_MAX_TOKENS=4096

# CORS: comma-separated origins allowed to call the API (the frontend origin).
CORS_ORIGINS=http://localhost:8765,https://artyd.github.io

# ---- Auth (protects the paid /api/chat + /api/batch endpoints) ----
# Set AUTH_SECRET to a long random string to ENFORCE login on the chat API
# (leave empty only for local dev). Generate e.g.:  openssl rand -hex 32
AUTH_SECRET=
# Invite code required to register a new account (leave empty to allow open sign-up).
SIGNUP_CODE=
# Max chat requests per user per minute.
CHAT_RATE_LIMIT=40

# ---- Gmail (RFQ drafts, gmail.compose scope — creates DRAFTS only, never sends) ----
# One-time setup: create a Google Cloud OAuth client (type "Web application") with
# redirect URI = https://<your-domain>/api/gmail/callback, download the JSON to
# secrets/gmail_credentials.json, then click "Підключити Gmail" in the RFQ tab.
GMAIL_REDIRECT_URI=https://getpostach.alliancegroup95.com/api/gmail/callback

# App
APP_ENV=dev
