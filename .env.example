# ---- Pigulkin backend configuration ----
# Copy to .env and fill in. Never commit the real .env.

# Database. Local dev default is SQLite; production uses Postgres.
# Postgres example: postgresql+psycopg://pigulkin:pigulkin@db:5432/pigulkin
DATABASE_URL=sqlite:///./pigulkin.db

# Where the CPHI_MILAN JSONL source data lives (used by the import script).
CPHI_DATA_DIR=C:/Projects/Артем/CPHI_MILAN/data
# Path to the CPHI_MILAN repo root (for supplier cards under suppliers/<slug>/).
CPHI_REPO_DIR=C:/Projects/Артем/CPHI_MILAN

# Anthropic Claude API (server-side chat). Get a key at https://console.anthropic.com
# NOTE: a Claude *subscription* is NOT the same as an API key — the backend needs an API key.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-4-6
CHAT_MAX_TOKENS=4096

# CORS: comma-separated origins allowed to call the API (the frontend origin).
CORS_ORIGINS=http://localhost:8765,https://artyd.github.io

# App
APP_ENV=dev
